{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure
           {:mvn/version "1.13.0-alpha10"}
           hyperlith/hyperlith                      {:local/root "../../../hyperlith"}
           io.nayuki/qrcodegen                      {:mvn/version "1.8.0"}
           com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
           com.clojure-goes-fast/clj-memory-meter   {:mvn/version "0.5.0"}}
 :aliases {:dev {:jvm-opts
                 ["--enable-native-access=ALL-UNNAMED"
                  "-Duser.timezone=UTC"
                  "-XX:+UseZGC"
                  "-XX:+UseCompactObjectHeaders"
                  "-Djdk.attach.allowAttachSelf"
                  "-XX:+EnableDynamicAgentLoading"
                  ;; For analysing GC pauses
                  ;; "-Xlog:gc*:file=gc.log"
                  ]}}}
