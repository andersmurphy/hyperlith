{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure {:mvn/version "1.13.0-alpha10"}
           hyperlith/hyperlith {:local/root "../../../hyperlith"}}
 :aliases {:dev   {:jvm-opts
                   ["--enable-native-access=ALL-UNNAMED"
                    "-Duser.timezone=UTC"
